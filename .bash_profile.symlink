# Source the shared POSIX-compatible `.profile`
if [[ -r "$HOME/.profile" ]]; then
  source "$HOME/.profile"
fi

#
# Add Bash-specifc environment setup here
#

# Login shells might not source `.bashrc` on their own!
if [[ -r "$HOME/.bashrc" ]]; then
  source "$HOME/.bashrc"
fi

# vim:ft=bash
