{
  "mod:prefix": {
    "alt-a": "prefix.literal",
    "h": "prefix.pane.go:left",
    "left": "prefix.pane.go:left",
    "j": "prefix.pane.go:down",
    "down": "prefix.pane.go:down",
    "k": "prefix.pane.go:up",
    "up": "prefix.pane.go:up",
    "l": "prefix.pane.go:right",
    "right": "prefix.pane.go:right",
    "H": "prefix.pane.swap:left",
    "J": "prefix.pane.swap:down",
    "K": "prefix.pane.swap:up",
    "L": "prefix.pane.swap:right",
    "tab": "prefix.next_pane",
    "shift-tab": "prefix.prev_pane",
    "v": "prefix.pane.split:right",
    "%": "prefix.pane.split:right",
    "-": "prefix.pane.split:down",
    "\"": "prefix.pane.split:down",
    "z": "prefix.pane.zoom",
    "x": "prefix.pane.close",
    "c": "prefix.new_tab",
    "n": "prefix.tab.next",
    "p": "prefix.tab.prev",
    "1": "prefix.tab.select:1",
    "2": "prefix.tab.select:2",
    "3": "prefix.tab.select:3",
    "4": "prefix.tab.select:4",
    "5": "prefix.tab.select:5",
    "6": "prefix.tab.select:6",
    "7": "prefix.tab.select:7",
    "8": "prefix.tab.select:8",
    "9": "prefix.tab.select:9",
    "T": "prefix.tab.rename",
    "X": "prefix.tab.close",
    "g": "prefix.mod.open:picker",
    "N": "prefix.space.new",
    "G": "prefix.new_worktree",
    "W": "prefix.space.rename",
    "D": "prefix.space.close",
    "o": "prefix.open_attention",
    "b": "prefix.layout.toggle:sidebar",
    "s": "prefix.app.settings",
    "?": "prefix.app.help",
    "d": "prefix.window.close",
    "q": "prefix.window.close"
  },
  "global": {
    "alt-a": "mod.open:prefix",
    "alt-1": "space.select:1",
    "alt-2": "space.select:2",
    "alt-3": "space.select:3",
    "alt-4": "space.select:4",
    "alt-5": "space.select:5",
    "alt-6": "space.select:6",
    "alt-7": "space.select:7",
    "alt-8": "space.select:8",
    "alt-9": "space.select:9",
    "alt-h": "pane.go:left",
    "alt-j": "pane.go:down",
    "alt-k": "pane.go:up",
    "alt-l": "pane.go:right",
    "alt-left": "pane.go:left",
    "alt-right": "pane.go:right",
    "alt-shift-h": "pane.swap:left",
    "alt-shift-j": "pane.swap:down",
    "alt-shift-k": "pane.swap:up",
    "alt-shift-l": "pane.swap:right",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "ctrl-=": "app.zoom_in",
    "ctrl-1": "tab.select:1",
    "ctrl-2": "tab.select:2",
    "ctrl-3": "tab.select:3",
    "ctrl-4": "tab.select:4",
    "ctrl-5": "tab.select:5",
    "ctrl-6": "tab.select:6",
    "ctrl-7": "tab.select:7",
    "ctrl-8": "tab.select:8",
    "ctrl-9": "tab.select:9",
    "ctrl-pagedown": "tab.next",
    "ctrl-pageup": "tab.prev",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "alt-]": "tab.next",
    "alt-[": "tab.prev",
    "ctrl-shift-pagedown": "space.next",
    "ctrl-shift-pageup": "space.prev",
    "alt-down": "agent.next",
    "alt-up": "agent.prev",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-b": "layout.toggle:sidebar",
    "ctrl-shift-n": "space.new",
    "ctrl-shift-t": "tab.new",
    "ctrl-shift-k": "mod.open:picker",
    "ctrl-shift-p": "app.palette",
    "ctrl-,": "app.settings",
    "ctrl-shift-o": "pane.split:right",
    "ctrl-shift-e": "pane.split:down",
    "ctrl-shift-w": "tab.close",
    "ctrl-shift-x": "pane.close",
    "ctrl-shift-z": "pane.zoom",
    "ctrl-shift-l": "layout.switch",
    "f2": "tab.rename",
    "shift-f2": "space.rename"
  },
  "terminal": {
    "ctrl-backspace": "send:\u0017",
    "ctrl-left": "send:\u001bb",
    "ctrl-right": "send:\u001bf",
    "ctrl-shift-c": "terminal.copy",
    "ctrl-shift-v": "terminal.paste",
    "ctrl-v": "terminal.paste_image"
  }
}
