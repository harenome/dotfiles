#===============================================================================

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Append to the history file, don't overwrite it
shopt -s histappend

# No duplicates nor lines starting with spaces
HISTCONTROL=ignoreboth

HISTSIZE=1000
HISTFILESIZE=2000

# Check window size after each command
shopt -s checkwinsize

# Some distributions support "$HOME/.bash_aliases" in their default `.bashrc`.
[[ -f "${HOME}/.bash_aliases" ]] && source "${HOME}/.bash_aliases"

# Some distributions support "$HOME/.bashrc.d" in their default `.bashrc`.
# See also `$HOME/.profile` and `$HOME/.profile.d/*.sh`:
# - `$HOME/.profile.d/` is for POSIX-compatible `.sh` files
# - `$HOME/.bashrc.d/` is for Bash-sepcific `.bash` files
if [[ -d "${HOME}"/.bashrc.d ]]; then
    for f in "${HOME}"/.bashrc.d/*.bash; do
        [[ -r "${f}" ]] && . "${f}"
    done
    unset f
fi

# Simple, lightweight, prompt
__prompt() {
  # Must be captured first
  local -a ps=( "${PIPESTATUS[@]}" )

  local s status
  local reset_color cwd_color at_color sep_color u_color h_color

  # colors for the prompt
  reset_color="\[\e[0m\]"
  cwd_color="\[\e[34m\]"
  at_color="\[\e[2m\]"
  sep_color="\[\e[1;2m\]"
  [[ "$(id -u)" -eq 0 ]] && u_color="\[\e[1;31m\]" || u_color="\[\e[1;32m\]"
  [[ -n "${SSH_CONNECTION}" ]] && h_color="\[\e[1;33m\]" || h_color=""

  for s in "${ps[@]}"; do
    (( s == 0 )) && continue
    local IFS='|'
    status="\[\e[31m\][${ps[*]}]\[\e[0m\]"
  done

  PS1=""
  PS1="${PS1}${u_color}\u${reset_color}"
  PS1="${PS1}${at_color}@${reset_color}"
  PS1="${PS1}${h_color}\h${reset_color}"
  PS1="${PS1}${cwd_color} \w ${reset_color}"
  PS1="${PS1}${status}"
  PS1="${PS1}${sep_color}\\$ ${reset_color}"
}

PROMPT_COMMAND=(__prompt "${PROMPT_COMMAND[@]}")

# vim:ft=bash
