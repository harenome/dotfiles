#===============================================================================
# ~/.bashrc configuration file.
# See the bash(1) man page.
#
# Maintainer: Harenome Ranaivoarivony-Razanajato
# License: WTFPLv2
#
# See https://github.com/harenome/dotfiles/blob/master/.bashrc.symlink
#===============================================================================

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# Append to the history file, don't overwrite it
shopt -s histappend

# No duplicates nor lines starting with spaces
HISTCONTROL=ignoreboth

HISTSIZE=1000
HISTFILESIZE=2000

# Check window size after each command
shopt -s checkwinsize

# Some distributions support "$HOME/.bash_aliases" in their default `.bashrc`.
[[ -f "${HOME}/.bash_aliases" ]] && source "${HOME}/.bash_aliases"

# Some distributions support "$HOME/.bashrc.d" in their default `.bashrc`.
# See also `$HOME/.profile` and `$HOME/.profile.d/*.sh`:
# - `$HOME/.profile.d/` is for POSIX-compatible `.sh` files
# - `$HOME/.bashrc.d/` is for Bash-sepcific `.bash` files
if [[ -d "${HOME}"/.bashrc.d ]]; then
    for f in "${HOME}"/.bashrc.d/*.bash; do
        [[ -r "${f}" ]] && . "${f}"
    done
    unset f
fi

# Colours for the prompt
reset_colour="\033[0m"
cwd_colour="\033[34m"
at_colour="\033[2m"
sep_colour="\033[1;2m"
[[ "$(id -u)" -eq 0 ]] && user_colour="\033[1;31m" || user_colour="\033[1;32m"
[[ -n "${SSH_CONNECTION}" ]] && host_colour="\033[1;33m" || host_colour=""

# Simple, lightweight, prompt
PS1=""
PS1="${PS1}${user_colour}\u${reset_colour}"
PS1="${PS1}${at_colour}@${reset_colour}"
PS1="${PS1}${host_colour}\h${reset_colour}"
PS1="${PS1}${cwd_colour} \w ${reset_colour}"
PS1="${PS1}${sep_colour}\\$ ${reset_colour}"

unset reset_colour cwd_colour user_colour host_colour at_colour sep_colour

# vim:ft=bash
